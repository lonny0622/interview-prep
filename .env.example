# LLM Gateway placeholders. Copy to .env.local when you are ready.
VITE_LLM_PROVIDER=openai-compatible
VITE_LLM_BASE_URL=https://api.example.com/v1
VITE_LLM_MODEL=your-model-name

# Server-only secret. Do not prefix with VITE_ and do not expose to browser code.
LLM_API_KEY=
LLM_IMPORT_MODEL=
LLM_REQUEST_TIMEOUT_MS=90000

# Server-only speech transcription provider. Keep the key out of VITE_ variables.
STT_PROVIDER=openai-compatible
STT_BASE_URL=https://api.example.com
STT_MODEL=your-transcription-model
STT_API_KEY=

# Future speech synthesis provider.
TTS_PROVIDER=
TTS_BASE_URL=
TTS_MODEL=
TTS_API_KEY=
