# Authentication is enabled automatically in production. Generate the hash with:
# pnpm auth:hash
AUTH_USERNAME=your-private-username
AUTH_PASSWORD_HASH=
# Generate with: openssl rand -base64 48
SESSION_SECRET=
# Exact public HTTPS origin; no trailing slash.
APP_ORIGIN=https://interview.example.com
AUTH_SESSION_TTL_SECONDS=43200
AUTH_MAX_ATTEMPTS=5
AUTH_ATTEMPT_WINDOW_SECONDS=900
AUTH_LOCKOUT_SECONDS=900
TRUST_PROXY=true
# Optional exact IP allowlist, comma-separated. Leave empty for dynamic networks.
AUTH_ALLOWED_IPS=

# LLM Gateway placeholders. Copy to .env.local when you are ready.
VITE_LLM_PROVIDER=openai-compatible
VITE_LLM_BASE_URL=https://api.example.com/v1
VITE_LLM_MODEL=your-model-name

# Server-only secret. Do not prefix with VITE_ and do not expose to browser code.
LLM_API_KEY=
LLM_IMPORT_MODEL=
LLM_REQUEST_TIMEOUT_MS=90000

# Server-only speech transcription provider. Keep the key out of VITE_ variables.
STT_PROVIDER=openai-compatible
STT_BASE_URL=https://api.example.com
STT_MODEL=your-transcription-model
STT_API_KEY=
STT_REQUEST_TIMEOUT_MS=90000

# Application-aware SQLite snapshots.
INTERVIEWPREP_BACKUP_DIR=./data/backups
INTERVIEWPREP_BACKUP_RETENTION=7

# Future speech synthesis provider.
TTS_PROVIDER=
TTS_BASE_URL=
TTS_MODEL=
TTS_API_KEY=
