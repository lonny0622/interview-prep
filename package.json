{
  "name": "interviewprep",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:client": "vite",
    "auth:hash": "node scripts/hash-password.mjs",
    "backup": "pnpm gateway:build && node dist-server/backup.js",
    "start": "node dist-server/gateway.js",
    "gateway": "pnpm gateway:build && node dist-server/gateway.js",
    "gateway:build": "tsc -p tsconfig.server.json",
    "gateway:check": "pnpm gateway:build",
    "test": "pnpm gateway:build && node --test server/tests/*.test.js",
    "build": "tsc -b && pnpm gateway:build && vite build",
    "lint": "oxlint && eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "lucide-react": "^1.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  },
  "packageManager": "pnpm@10.12.4+sha512.5ea8b0deed94ed68691c9bad4c955492705c5eeb8a87ef86bc62c74a26b037b08ff9570f108b2e4dbd1dd1a9186fea925e527f141c648e85af45631074680184"
}
